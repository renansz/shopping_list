# Copie para .env e ajuste. O docker-compose e o systemd leem este arquivo.

# Senha unica da casa. Todo mundo da familia usa a mesma.
# OBRIGATORIA (o servidor nao sobe sem ela, a menos que AUTH_DISABLED=1).
# Esta e a senha INICIAL. Depois que alguem trocar a senha pelo proprio app
# (menu > Acessos > Trocar a senha), o valor aqui deixa de valer - senao
# trocar a senha nao adiantaria para quem ja conhecia a antiga.
# Esqueceu a senha? `npm run senha` (ou `docker compose exec lista node
# tools/senha.mjs`) redefine pelo servidor.
HOUSEHOLD_PASSWORD=troque-esta-senha

# Porta e interface de escuta (uso sem Docker).
PORT=3000
HOST=0.0.0.0

# Só com Docker: em que porta do localhost da VPS a aplicação aparece.
# Mude se a 3000 já estiver ocupada por outro app na máquina.
PORTA_LOCAL=3000

# Só com deploy/docker-compose.shared-proxy.yml: nome da rede Docker do proxy
# que já existe na VPS (Caddy/Nginx/Traefik em container), para o app entrar
# nela e ser alcançado sem publicar porta nenhuma no host. Descubra o nome com
# `docker network ls`. Veja o cabeçalho do arquivo overlay para o passo a passo.
# REDE_PROXY=nome_da_rede_do_outro_projeto

# Onde fica o banco SQLite (um arquivo so).
DATA_DIR=./data

# Cookie seguro: auto (detecta HTTPS pelo proxy) | true | false
COOKIE_SECURE=auto

# Confiar nos cabecalhos X-Forwarded-* (use 1 atras de Caddy/Nginx/Traefik).
TRUST_PROXY=1

# Apenas para desenvolvimento local: 1 desliga o login.
AUTH_DISABLED=0
