# Copie para .env e ajuste. O docker-compose e o systemd leem este arquivo.

# Senha unica da casa. Todo mundo da familia usa a mesma.
# OBRIGATORIA (o servidor nao sobe sem ela, a menos que AUTH_DISABLED=1).
HOUSEHOLD_PASSWORD=troque-esta-senha

# Porta e interface de escuta.
PORT=3000
HOST=0.0.0.0

# Onde fica o banco SQLite (um arquivo so).
DATA_DIR=./data

# Segredo usado para assinar o cookie de sessao.
# Se ficar vazio, e gerado e guardado no banco automaticamente.
# Trocar o valor desloga todo mundo.
SESSION_SECRET=

# Cookie seguro: auto (detecta HTTPS pelo proxy) | true | false
COOKIE_SECURE=auto

# Confiar nos cabecalhos X-Forwarded-* (use 1 atras de Caddy/Nginx/Traefik).
TRUST_PROXY=1

# Duracao da sessao em dias.
SESSION_DAYS=180

# Apenas para desenvolvimento local: 1 desliga o login.
AUTH_DISABLED=0
